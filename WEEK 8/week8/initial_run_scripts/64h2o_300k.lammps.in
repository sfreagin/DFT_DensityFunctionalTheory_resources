# ============================================================
# 64 H2O molecules, TIP4P/2005, NVT at 300 K
# Implicit M-site implementation
# ============================================================

units           real
atom_style      full
boundary        p p p

# 12.4 A cubic box
region          box block -6.2 6.2 -6.2 6.2 -6.2 6.2 units box

# Only two actual atom types: O and H
# Reserve topology storage for H-O-H molecules
create_box      2 box bond/types 1 angle/types 1 &
                extra/bond/per/atom 2 &
                extra/angle/per/atom 1 &
                extra/special/per/atom 2

# ------------------------------------------------------------
# Masses
# ------------------------------------------------------------

mass            1 15.9994
mass            2 1.008

# ------------------------------------------------------------
# TIP4P/2005 intermolecular interactions
# ------------------------------------------------------------

pair_style      lj/cut/tip4p/long 1 2 1 1 0.1546 10.0
pair_coeff      1 1 0.1852 3.1589
pair_coeff      2 2 0.0 1.0

kspace_style    pppm/tip4p 1.0e-5

# Useful/required for KOKKOS PPPM/TIP4P
newton          on

# ------------------------------------------------------------
# Rigid water geometry
# ------------------------------------------------------------

bond_style      zero
bond_coeff      1 0.9572

angle_style     zero
angle_coeff     1 104.52

# tip4p.mol should contain:
# 3 atoms, 2 bonds, 1 angle
# O = type 1, H = type 2
# charges: O = -1.1128, H = +0.5564

molecule        water tip4p.mol

# Create 64 randomly oriented water molecules
create_atoms    0 random 64 34564 NULL &
                mol water 25367 &
                overlap 1.33 maxtry 1000 units box

# ------------------------------------------------------------
# SHAKE constraints
# ------------------------------------------------------------

fix             constraints all shake 1.0e-5 100 0 b 1 a 1

# Relax bad intermolecular contacts introduced by random packing
minimize        1.0e-4 1.0e-4 5000 50000

# ------------------------------------------------------------
# MD setup
# ------------------------------------------------------------

reset_timestep  0
timestep        2.0

velocity        all create 300.0 4928459 mom yes rot yes dist gaussian

fix             thermostat all nvt temp 300.0 300.0 100.0

thermo          100
thermo_style    custom step time temp pe ke etotal press density

# ------------------------------------------------------------
# Equilibration: 100 ps
# 50000 steps x 2 fs = 100000 fs = 100 ps
# ------------------------------------------------------------

run             50000
write_data      water64_equilibrated.data
write_restart water64_equilibrated.restart
# ------------------------------------------------------------
# Production: diffusion calculation
# ------------------------------------------------------------

#reset_timestep  0

group           oxygen type 1

compute         msdO oxygen msd com yes

# Save total oxygen MSD every 100 steps = every 0.2 ps
fix             msdout all ave/time 100 1 100 c_msdO[4] file msd_O_64.dat

dump traj all custom 500 water64.lammpstrj id mol type x y z
dump_modify traj sort id

# Optional: include MSD directly in log output
thermo_style    custom step time temp pe ke etotal press density c_msdO[4]

# 500 ps production
# 250000 steps x 2 fs = 500 ps
run             250000
write_data    water64_final.data
