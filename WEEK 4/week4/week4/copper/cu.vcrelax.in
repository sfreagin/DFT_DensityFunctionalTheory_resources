&control
  calculation = "vc-relax",
  prefix = "cu",
  pseudo_dir = "/scratch/mate250-fa26/pseudos/SSSP_1.3.0_PBE_efficiency/"
  outdir = "./cu/"
  etot_conv_thr=1D-4
  forc_conv_thr=1D-4
/

&system
  ibrav = 2,
  celldm(1) = 6.678,
  nat = 1,
  ntyp = 1,
  ecutwfc = 40,
  ecutrho = 320,
  occupations = "smearing",
  smearing = "mp",
  degauss = 0.01,
  nbnd = 16
/

&electrons
  conv_thr = 1e-9,
/
&ions
/
&cell
 cell_dofree='xyz'
/
ATOMIC_SPECIES
Cu 63.546 Cu.paw.z_11.ld1.psl.v1.0.0-low.upf 

ATOMIC_POSITIONS alat
Cu 0.00 0.00 0.00

