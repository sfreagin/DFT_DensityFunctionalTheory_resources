&control
  calculation = 'nscf',
  prefix = 'lacoo3',
  pseudo_dir = '/scratch/mate250-fa26/pseudos/pslibrary/.'
  outdir = './lacoo3_rhomb/'
  nstep=50
  !disk_io='low'
  !max_seconds=10800
  !restart_mode='restart'
/
&system
  ibrav = 0,
  nat = 10, ntyp = 3,
  ecutwfc = 90.0, ecutrho =720,
  occupations='tetrahedra'!,smearing='gauss', degauss=0.0037
  nspin=2
  starting_magnetization(2)=0.01
/
&electrons
  conv_thr = 1.0d-6,
  electron_maxstep = 400
  mixing_beta = 0.1D0
  startingpot='file'
  startingwfc='file'
/
&ions
/
&cell
 cell_dofree='all'
/
