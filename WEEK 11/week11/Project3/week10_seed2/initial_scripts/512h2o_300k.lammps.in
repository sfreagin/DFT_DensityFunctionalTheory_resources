units           metal
atom_style      atomic
boundary        p p p

read_data water64_dp_equilibrated.data
replicate 2 2 2

pair_style      deepmd graph.pb
pair_coeff      * * O H

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes

timestep        0.0005
velocity        all create 300.0 23456789 mom yes rot yes dist gaussian
fix             thermostat all nvt temp 300.0 300.0 0.10

thermo          100
thermo_style    custom step time temp pe ke etotal press vol

# 50 ps equilibration
run             100000

write_data water512_dp_equilibrated.data
write_restart water512_dp_equilibrated.restart
