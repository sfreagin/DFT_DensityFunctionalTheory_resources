units           metal
atom_style      atomic
boundary        p p p

region          box block -6.2 6.2 -6.2 6.2 -6.2 6.2 units box
create_box      2 box

mass            1 15.9994
mass            2 1.008

molecule        water water_dp.mol

create_atoms    0 random 64 34564 NULL &
                mol water 25367 &
                overlap 1.33 maxtry 1000 units box

pair_style      deepmd graph.pb
pair_coeff      * * O H

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes

timestep        0.0005
velocity        all create 300.0 23456789 mom yes rot yes dist gaussian
fix             thermostat all nvt temp 300.0 300.0 0.10

thermo          100
thermo_style    custom step time temp pe ke etotal press vol

# 10 ps equilibration
run             20000

write_data water64_dp_equilibrated.data
write_restart water64_dp_equilibrated.restart
